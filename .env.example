# ─── MongoDB ───────────────────────────────────────────────────────────────
# Local dev:
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=motorsport_db

# Production (MongoDB Atlas) — uncomment and fill in:
# MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/motorsport_db?retryWrites=true&w=majority
# DATABASE_NAME=motorsport_db

# ─── Cloudinary (image CDN) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Newsletter (Gmail SMTP) ─────────────────────────────────────────────
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# ─── CORS (production) ───────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * for dev.
ALLOWED_ORIGINS=*
